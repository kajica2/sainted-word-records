node_modules
dist
dist-dev
library
.DS_Store
.vite
*.log
.env
.env.local
verify-screenshots/
_probe[-_]*.mjs
_smoke[-_]*.mjs
# Local dev artifacts
data/auth/
# Local invite-code store (the CSV above is the source of truth; the store
# itself is runtime state and lives in Postgres in production)
data/invite-store/
# Local control-centre action log (runtime state; Postgres in production)
data/control/
_vinyl-sample/
.vercel

# Build outputs (also covers timestamped snapshots like "dist 15.28.45/")
dist*/

# Caches / tooling scratch
__pycache__/
.hermes/
.hermes-plans/

# superpowers skill state (per-sprint sdd progress logs)
.superpowers/

# Build / source shadows. Vite copies public/* into dist on every build via
# copyPublicDir, then copyStatic() re-copies the canonical root files in
# closeBundle, so root wins. public/ is therefore stale and shadowed by root.
public/

# Heavy media directories — not part of the deployable build (curated
# library/ is the only media shipped; see vite.config.js closeBundle).
launch/
items_/
keyart/
style-graphics/
style-videos/
style-videos-original/
style-videos-watermarked/

# One-off scratch scripts (debug/audit/verification on demand).
# Anchored at the repo root so scripts/check-*.mjs (build tooling that
# npm run + CI calls) stays tracked.
/check-*.mjs
/snap-*.mjs
/generate-*.mjs
/inspect-*.mjs
/crawl.mjs
/deploy-verify.mjs
/render-*.mjs

# Accidental editor backups
*.bak1

# Throwaway HTML scratch (one-off pages not part of deploy)
audio-analysis-v2-test.html
interactive-personas.html
PR-rendered.html

# Planning docs not yet ready for commit
PRD.md
ROADMAP.md
media-prompts.md

# Test / audit / verify scratch outputs. Several verify-*.mjs scripts write
# here (e.g. verify-versions.mjs → out/versions_live.png). Files here are
# never part of the deploy.
out/

# Planning output (PRD drafts, process-flow, prototype HTML)
output/

# Render pipeline output (render-intro-10s.mjs → render-out/intro-10s/)
render-out/

# Verify scripts write here. check-*.mjs / verify-watermark.mjs sometimes
# leave an orphan root-level PNG.
verify-watermark.png

# Python tooling (icon generator; not part of the JS build)
_gen_*.py

# Throwaway smoke/probe scripts (debug on demand, not part of the JS build)
_probe[-_]*.mjs
_smoke[-_]*.mjs
.env*

# Throwaway Puppeteer-driven Vercel debug sessions (manual Chrome
# inspection via CDP :9222). One-off helpers; not part of the app.
_vercel-debug.mjs

# Vodolija logo candidate PNGs (large; reviewed locally, not committed)
artists/vodolija/_candidates_web/
artists/vodolija/_candidates/
# Shot-list reference frames (Midjourney candidates, large; reviewed locally)
shotlist/_candidates_web/
shotlist/_candidates/
# Vintage gallery unreviewed Midjourney candidates (728 MB of source PNGs;
# only the curated WebPs in gallery-vintage/*.webp ship to deploy)
gallery-vintage/_candidates_web/
gallery-vintage/_candidates/

# Expo / React Native sub-project lives in this repo for local dev only.
# It is a separate app (its own package.json, node_modules, app.json) and
# must NOT be part of the Vite+Vercel static deploy. node_modules inside
# score-app/ would otherwise push the deploy well past Vercel's size cap.
score-app/
score-app/**/node_modules/

# Work artifacts (loop prompts, wiggum config, TODOs, runtime data)
.wiggum.toml
LOOP-PROMPT.md
TODO.md
personas_extracted.json
artists.json

# Throwaway debug/audit scripts at repo root (no underscore prefix).
# The _probe[-_]*.mjs / _smoke[-_]*.mjs rules above cover the underscored
# names in both spellings (_probe-a.mjs and _probe_a.mjs); these cover the
# bare-prefixed probes.
probe-*.mjs
_archive/

# Isolated worktrees created for in-progress feature work (subagent-driven
# development, parallel sprints). Tracked by .git/worktrees/ but the working
# trees themselves must never be committed.
.worktrees/

# PT license keys minted by scripts/generate-pt-keys.mjs (never commit: they are the product)
pt-keys.local.txt

# upload-youtube.mjs screenshots (profile now lives in Application Support)
out/

# Local orchestrator vault (the daily journal lives in this folder
# and is meant to be opened in Obsidian, not committed to the repo)
.obsidian-swr/

# Generated media inventory (rebuilt by scripts/build-inventory.mjs)
media/inventory.json

# The living history: the data file and the per-generation archives, both
# built by scripts/generate-generations.mjs from marketing/generations.json
# and the tree it describes. The AUTHORED source (marketing/generations.json)
# is tracked — the patterns are anchored to the repository root so they do
# not match it.
/generations.json
/generations/

# Agent hook logs. Written by the orchestration tooling on every run and
# never an input to anything - they were untracked but committable.
/.omb/logs/

# Scratch output from the sign-in benefits experiments. `data/` is only
# partially ignored (data/auth/, data/invite-store/ are real state), so
# an experiment's working files fall through the gap and show up as
# untracked in every status.
/data/swr-*

# Live invite codes — register via /api/invite/register (workflow or admin);
# must never ship in dist/ or stay in git history after rotation (purge separately).
/data/invite-codes.csv
