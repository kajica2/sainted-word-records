# =============================================================================
# Sainted Word Records — environment variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ----- M1: Auth + storage -----

# Where the JSON store + uploaded blobs live (dev/local). Default: ./data
# In Vercel prod, this is the only writable filesystem, so on Vercel set
# this to /tmp. For multi-instance Vercel deploys you'll want Postgres
# instead; see ADR-001.
SWRC_DATA_DIR=./data

# Public origin of the deployed app. Used to build magic-link URLs when
# the request host header isn't trustworthy (rare).
SWRC_APP_ORIGIN=https://sainted-word-records.vercel.app

# ----- M1: Magic-link email (optional in dev) -----
# If unset, magic links print to stdout (visible in `npm run dev` console).
# Set both to enable real email sending via Resend (free tier: 100/day).
# RESEND_API_KEY=re_xxx
# SWR_FROM_EMAIL=SWR <noreply@saintedwordrecords.com>

# ----- M1: Future (M2/M3) -----
# DATABASE_URL=postgres://user:pass@host:5432/db        # M2
# R2_ACCOUNT_ID=xxx                                     # M2
# R2_ACCESS_KEY_ID=xxx                                  # M2
# R2_SECRET_ACCESS_KEY=xxx                              # M2
# R2_BUCKET=swr-user-content                             # M2
# STRIPE_SECRET_KEY=sk_test_xxx                          # M2
# STRIPE_WEBHOOK_SECRET=whsec_xxx                        # M2
# LIVEBLOCKS_SECRET_KEY=sk_dev_xxx                       # M3
