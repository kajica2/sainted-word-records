# =============================================================================
# Sainted Word Records — environment variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ----- M1: Auth + storage -----

# Where the JSON store + uploaded blobs live (dev/local). Default: ./data
# In Vercel prod, this is the only writable filesystem, so on Vercel set
# this to /tmp. For multi-instance Vercel deploys you'll want Postgres
# instead; see ADR-001.
SWRC_DATA_DIR=./data

# ----- Storage backend: Vercel Blob -----
# Uploaded blobs (images / audio / clips) persist across cold starts when
# EITHER credential set resolves:
#
#   a) BLOB_READ_WRITE_TOKEN                       (per-store token)
#   b) BLOB_STORE_ID + VERCEL_OIDC_TOKEN            (OIDC)
#
# Both are set up from the dashboard:
#   Storage → Create Database → Blob → then "Connect Project" on the
#   store. Tick "Add a read-write token env var" to get (a); leaving it
#   unticked gives (b) only, with VERCEL_OIDC_TOKEN injected by the
#   platform per invocation.
#
# Either works — the storage layer detects both. Confirm which is live:
#   curl 'https://<host>/api/manifest?action=health'   →  .storage.mode
#   'local-fs' means uploads will NOT survive a cold start.
#
# When NEITHER is set (local `npm run dev` without a Vercel account): the
# storage layer falls back to $SWRC_DATA_DIR/storage/<userId>/. Uploads
# persist for the life of the dev process only.
#
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Public origin of the deployed app. Used to build magic-link URLs when
# the request host header isn't trustworthy (rare).
SWRC_APP_ORIGIN=https://sainted-word-records.vercel.app

# ----- M1: Magic-link email (optional in dev) -----
# If unset, magic links print to stdout (visible in `npm run dev` console).
# Three transports are supported, picked at call time by api/_lib/email.js:
#
#   1. SMTP (any provider — Mailgun, SES SMTP, Postmark SMTP, Postfix, etc.)
#      Set SMTP_HOST to enable. Takes precedence over Resend.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                  # 587 = STARTTLS; 465 = implicit TLS (secure:true)
# SMTP_USER=apikey               # optional for open relays
# SMTP_PASS=secret               # optional for open relays
# SMTP_SECURE=false              # explicit override; defaults to (port === 465)
#
#   2. Resend (HTTPS API; takes precedence over stdout only when SMTP not set)
# RESEND_API_KEY=re_xxx
#
#   3. stdout (default if neither transport is configured)
#
# Common:
# SWR_FROM_EMAIL=SWR <noreply@saintedwordrecords.com>

# ----- M1: Future (M2/M3) -----
# DATABASE_URL=postgres://user:pass@host:5432/db        # M2
# R2_ACCOUNT_ID=xxx                                     # M2
# R2_ACCESS_KEY_ID=xxx                                  # M2
# R2_SECRET_ACCESS_KEY=xxx                              # M2
# R2_BUCKET=swr-user-content                             # M2
# STRIPE_SECRET_KEY=sk_test_xxx                          # M2
# STRIPE_WEBHOOK_SECRET=whsec_xxx                        # M2
# LIVEBLOCKS_SECRET_KEY=sk_dev_xxx                       # M3
