{
  "name": "sainted-word-records",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Algorithmic audio-reactive video engine. Drop in a song, drop in a library of videos / GIFs / images, get a reactive layered composition.",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-library.mjs",
    "build": "vite build",
    "build:vercel": "node scripts/fetch-library.mjs && vite build",
    "preview": "vite preview --port 4173",
    "upload:library": "node scripts/upload-library.mjs",
    "check": "npm run check:syntax && npm run check:manifest && npm run check:bundle && npm run check:auth-unit && npm run test:smtp && node scripts/test-api.mjs",
    "check:full": "npm run check && npm run check:verify",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:bundle": "bash scripts/build-magenta-dsp-bundle.sh",
    "check:auth-unit": "node scripts/check-auth-unit.mjs",
    "check:unit": "npm run test:generated-audio",
    "test:generated-audio": "node tests/generated-audio.test.mjs",
    "test:smtp": "node --test verify-smtp-transport.mjs",
    "check:verify": "node scripts/check-verify-smoke.mjs",
    "verify:cloud-auth": "node verify-cloud-auth.mjs",
    "verify:hf-publish": "node verify-hf-publish.mjs",
    "verify:rotation-enabled": "node verify-rotation-enabled.mjs",
    "verify:story-graph": "node verify-story-graph.mjs",
    "verify:hallucination-story": "node verify-hallucination-story.mjs",
    "verify:autoplay": "node verify-autoplay.mjs",
    "verify:e2e-media-record": "node verify-e2e-media-record.mjs",
    "verify:library-loads": "node verify-library-loads.mjs",
    "verify:collage-loads": "node verify-collage-loads.mjs",
    "verify:overlay-failure": "node verify-overlay-failure.mjs",
    "verify:library-switcher": "node verify-library-switcher.mjs",
    "verify:music-video-maker": "node verify-music-video-maker.mjs",
    "verify:mvm-review-fixes": "node verify-mvm-review-fixes.mjs",
    "verify:mvm-phase8": "node verify-mvm-phase8.mjs",
    "verify:mvm-phase9": "node verify-mvm-phase9.mjs",
    "verify:mvm-phase10": "node verify-mvm-phase10.mjs",
    "verify:weddings": "node verify-weddings.mjs",
    "verify:bachdrop": "node verify-bachdrop.mjs",
    "verify:onboarding-hf": "node verify-onboarding-hf.mjs",
    "verify:brutalist": "node verify-brutalist.mjs",
    "verify:loops": "node verify-loops.mjs",
    "verify:persona-engine": "node verify-persona-engine.mjs",
    "verify:persona-v": "node verify-persona-v.mjs",
    "verify:artists": "node verify-artists.mjs",
    "verify:shotlist": "node verify-shotlist.mjs",
    "verify:smtp": "node --test verify-smtp-transport.mjs",
    "verify:curator-batch": "node verify-curator-batch.mjs",
    "clean": "rm -rf dist dist-dev .vite"
  },
  "devDependencies": {
    "mp4-muxer": "^5.2.2",
    "puppeteer": "^25.8.0",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "nodemailer": "^10.0.8"
  }
}
