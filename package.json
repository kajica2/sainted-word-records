{
  "name": "sainted-word-records",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Algorithmic audio-reactive video engine. Drop in a song, drop in a library of videos / GIFs / images, get a reactive layered composition.",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-library.mjs",
    "build": "vite build",
    "build:vercel": "node scripts/fetch-library.mjs && vite build",
    "preview": "vite preview --port 4173",
    "upload:library": "node scripts/upload-library.mjs",
    "check": "npm run check:syntax && npm run check:manifest && node scripts/test-api.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "verify:cloud-auth": "node verify-cloud-auth.mjs",
    "verify:rotation-enabled": "node verify-rotation-enabled.mjs",
    "verify:story-graph": "node verify-story-graph.mjs",
    "verify:hallucination-story": "node verify-hallucination-story.mjs",
    "verify:autoplay": "node verify-autoplay.mjs",
    "verify:e2e-media-record": "node verify-e2e-media-record.mjs",
    "verify:library-switcher": "node verify-library-switcher.mjs",
    "verify:music-video-maker": "node verify-music-video-maker.mjs",
    "clean": "rm -rf dist dist-dev .vite"
  },
  "devDependencies": {
    "vite": "^5.4.10"
  }
}
