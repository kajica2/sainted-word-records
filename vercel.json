{
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/engine", "destination": "/engine.html" },
    { "source": "/engine/", "destination": "/engine.html" }
  ]
}
