{
  "version": 1,
  "repositories": ["braincrew-lab/deep-agent-builder"],
  "language": "ko",
  "coordinator_host": "REPLACE_WITH_COORDINATOR_HOSTNAME",
  "state_dir": "/REPLACE_WITH_PRIVATE_LOCAL_STATE/issue-maintainer",
  "writer_login": "REPLACE_WITH_GITHUB_WRITER_LOGIN",
  "transport": "local",
  "ssh_host": null,
  "executable": ["omb", "issue-maintainer", "gateway"],
  "limits": {
    "read_timeout": 30,
    "write_timeout": 60,
