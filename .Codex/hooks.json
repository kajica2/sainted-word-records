{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/omb/omb-hook.sh PreToolUse",
            "timeout": 10
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/omb/omb-hook.sh PreToolUse",
            "timeout": 10
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/omb/omb-hook.sh PreToolUse",
            "timeout": 10
          }
        ],
        "matcher": "Agent"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/omb/omb-hook.sh PreToolUse",
            "timeout": 10
          }
        ],
        "matcher": "Glob|Grep"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/omb/omb-hook.sh PreToolUse",
            "timeout": 10
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/omb/omb-hook.sh PostToolUse",
            "timeout": 30
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/omb/omb-hook.sh SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/omb/omb-hook.sh Stop",
            "timeout": 10
          }
        ],
        "matcher": "Agent"
      }
    ]
  }
}
