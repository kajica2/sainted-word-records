  "example": {
    "color-contrast": {
      "help": "Elements must meet minimum color contrast ratio thresholds",
      "impact": "serious",
      "example": "/",
      "target": "#features > .shell > .section__head > .section__kicker"
    },
    "label-content-name-mismatch": {
      "help": "Elements must have their visible text as part of their accessible name",
      "impact": "serious",
      "example": "/engine",
      "target": "#swr-version-badge"
    },
    "region": {
      "help": "All page content should be contained by landmarks",
      "impact": "moderate",
      "example": "/engine",
      "target": ".basic-brand"
    },
    "heading-order": {
      "help": "Heading levels should only increase by one",
      "impact": "moderate",
      "example": "/versions",
      "target": ".preset-day:nth-child(1) > .day-head > h4"
    },
    "link-name": {
      "help": "Links must have discernible text",
      "impact": "serious",
      "example": "/versions",
      "target": ".looks:nth-child(2) > .style-card[href$=\"neon\"]"
    },
    "label-title-only": {
      "help": "Form elements should have a visible label",
      "impact": "serious",
      "example": "/visual-languages",
      "target": "#looks"
    },
    "label": {
      "help": "Form elements must have labels",
      "impact": "critical",
      "example": "/versions/music-video",
      "target": "#temp"
    },
    "landmark-one-main": {
      "help": "Document should have one main landmark",
      "impact": "moderate",
      "example": "/versions/music-video",
      "target": "html"
    },
    "landmark-unique": {
      "help": "Landmarks should have a unique role or role/label/title (i.e. accessible name) combination",
      "impact": "moderate",
      "example": "/versions/music-video",
      "target": ".lib"
    },
    "page-has-heading-one": {
      "help": "Page should contain a level-one heading",
      "impact": "moderate",
      "example": "/versions/music-video",
      "target": "html"
    },
    "button-name": {
      "help": "Buttons must have discernible text",
      "impact": "critical",
      "example": "/versions/echo-manifold",
      "target": "#prev-btn"
    },
    "scrollable-region-focusable": {
      "help": "Scrollable region must have keyboard access",
      "impact": "serious",
      "example": "/shotlist",
      "target": "#jsonOut"
    },
    "image-alt": {
      "help": "Images must have alternative text",
      "impact": "critical",
      "example": "/versions/music-video-mtv",
      "target": ".li.is-offline:nth-child(1) > img"
    },
    "select-name": {
      "help": "Select element must have an accessible name",
      "impact": "critical",
      "example": "/versions/simple",
      "target": "#rec-format"
    },
    "aria-prohibited-attr": {
      "help": "Elements must only use permitted ARIA attributes",
      "impact": "serious",
      "example": "/versions/console",
      "target": ".hero-visual"
    },
    "link-in-text-block": {
      "help": "Links must be distinguishable without relying on color",
      "impact": "serious",
      "example": "/persona-library",
      "target": ".text-slate-500.text-\\[12px\\].mt-4 > .hover\\:underline[href$=\"#memo\"]"
    },
    "landmark-main-is-top-level": {
      "help": "Main landmark should not be contained in another landmark",
      "impact": "moderate",
      "example": "/portfolio",
      "target": "#main"
    },
    "skip-link": {
      "help": "The skip-link target should exist and be focusable",
      "impact": "moderate",
      "example": "/photo-scrolls",
      "target": ".swr-skip"
    },
    "aria-hidden-focus": {
      "help": "ARIA hidden element must not be focusable or contain focusable elements",
      "impact": "serious",
      "example": "/gallery/albums",
      "target": ".grad-1"
    }
  }
}
