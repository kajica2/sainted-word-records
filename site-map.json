{
  "$schema": "./site-map.schema.json",
  "_comment": "Canonical site IA. Source of truth for navigation, vercel.json rewrites, and vite.config.js rootFiles. Edit this file, then run scripts/generate-vercel-rewrites.mjs to regenerate vercel.json. Categories: engine, gallery, persona, learn, tool, page, legal.",
  "_maintenance": {
    "addPage": [
      "1. Add page to appropriate section (nav, footer, auth, legal, or tools)",
      "2. Run: node scripts/generate-vercel-rewrites.mjs",
      "3. Run: node scripts/migrate-html.mjs <page.html> (adds shared CSS/JS)",
      "4. Run: npm run verify:site-nav (smoke test)"
    ],
    "archivePage": [
      "1. Add filename to 'archived' array below",
      "2. Run: node scripts/archive-pages.mjs --dry-run (preview)",
      "3. Run: node scripts/archive-pages.mjs (moves files to _archive/)",
      "4. Run: node scripts/generate-vercel-rewrites.mjs"
    ],
    "removePage": [
      "1. Remove entry from site-map.json (nav, footer, auth, legal, or tools)",
      "2. Delete the .html file",
      "3. Run: node scripts/generate-vercel-rewrites.mjs"
    ],
    "discoverPages": "Run: node scripts/generate-site-manifest.mjs --dry-run (auto-adds untracked HTML files)"
  },
  "_pathConventions": {
    "root": "/page-name → /page-name.html",
    "subdirectory": "/artists/foo → /artists/foo.html",
    "gallery": "/gallery/music → /gallery-music.html (hyphenated)",
    "withDotHtml": "/legal/privacy.html → /legal/privacy.html (as-is)",
    "artistsIndex": "/artists → /artists/index.html",
    "dynamic": "/s/:id → handled by share-view.html client-side"
  },
