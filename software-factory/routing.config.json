{
  "version": "3.0",
  "factory": "Sainted Word Records",
  "providers": {
    "minimax": {
      "label": "MiniMax",
      "wire_format": "anthropic-messages",
      "base_url": "https://api.minimax.io/anthropic",
      "base_url_env": "MINIMAX_BASE_URL",
      "messages_path": "/v1/messages",
      "models_path": "/v1/models",
      "auth": { "type": "bearer", "env": "MINIMAX_API_KEY" },
      "headers": { "anthropic-version": "2023-06-01" },
      "notes": [
        "MiniMax speaks the Anthropic Messages API, so the factory keeps the",
        "Anthropic request shape and only swaps the provider block.",
        "China endpoint: https://api.minimaxi.com/anthropic"
      ]
    },
    "opencode": {
      "label": "OpenCode Zen",
      "wire_format": "per-model",
      "base_url": "https://opencode.ai/zen/v1",
      "base_url_env": "OPENCODE_BASE_URL",
      "messages_path": "/messages",
      "responses_path": "/responses",
      "chat_path": "/chat/completions",
      "models_path": "/models",
      "auth": { "type": "bearer", "env": "OPENCODE_API_KEY" },
      "notes": [
        "Zen is a gateway, not a model. Its models sit on three different",
        "endpoints depending on the family: /messages for Claude and Qwen,",
        "/responses for the GPTs, /chat/completions for everything else.",
        "Each model in the catalog below therefore carries its own format.",
        "Newer Console base: https://opencode.ai/inference (override with",
        "OPENCODE_BASE_URL). Model list: GET /zen/v1/models"
      ]
    },
    "xai": {
      "label": "xAI (Grok)",
      "wire_format": "openai-responses",
      "base_url": "https://api.x.ai/v1",
      "base_url_env": "XAI_BASE_URL",
      "responses_path": "/responses",
      "chat_path": "/chat/completions",
      "auth": { "type": "bearer", "env": "XAI_API_KEY" },
      "notes": [
        "xAI's Chat Completions API is deprecated — the Responses API is the",
        "supported surface, and it is the only one that carries the model's",
        "encrypted reasoning across a tool loop.",
        "US regional endpoint: https://us.api.x.ai/v1 (10% premium)."
      ]
    },
    "antigravity": {
      "label": "Google Antigravity",
      "wire_format": "gemini-interactions",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "base_url_env": "GEMINI_BASE_URL",
      "interaction_path": "/interactions",
      "agent": "antigravity-preview-09-2026",
      "auth": { "type": "header", "header": "x-goog-api-key", "env": "GEMINI_API_KEY" },
      "notes": [
        "Antigravity is not a chat model — it is a managed agent that plans,",
        "runs code and browses inside a Google-hosted Linux sandbox.",
        "It has no client-side tools, so it CANNOT read or write this repo.",
        "Only route a task here when everything it needs is inlined in the",
        "prompt. Its job in this factory is research and second opinion."
      ]
    },
    "antigravity-cli": {
      "label": "Antigravity CLI (local)",
      "wire_format": "cli",
      "command": "agy",
      "args": ["-p"],
      "model_flag": "--model",
      "effort_flag": "--effort",
      "notes": [
        "Runs on this machine, with this user's permissions, against this",
        "working tree. NOT covered by the bridge's write allowlist — the",
        "agent's own permissions are the guardrail.",
        "agy -p <prompt> --model <slug> --effort low|medium|high"
      ]
    },
    "opencode-cli": {
      "label": "OpenCode CLI (local)",
      "wire_format": "cli",
      "command": "opencode",
      "args": ["run"],
      "model_flag": "--model",
      "notes": [
        "opencode run <prompt> --model provider/model",
        "Local, with the local user's permissions."
      ]
    }
  },
  "models": {
