{
  "version": "2.0",
  "factory": "Sainted Word Records",
  "provider": {
    "name": "minimax",
    "base_url": "https://api.minimax.io/anthropic",
    "base_url_cn": "https://api.minimaxi.com/anthropic",
    "messages_path": "/v1/messages",
    "models_path": "/v1/models",
    "count_tokens_path": "/v1/messages/count_tokens",
    "api_key_env": "MINIMAX_API_KEY",
    "auth_header": "Authorization: Bearer ${MINIMAX_API_KEY}",
    "anthropic_version": "2023-06-01",
    "wire_format": "anthropic-messages",
    "notes": [
      "MiniMax speaks the Anthropic Messages API, so the factory keeps the",
      "Anthropic request/response shape and only swaps the provider block.",
      "Set MINIMAX_BASE_URL to https://api.minimaxi.com/anthropic for the",
      "China region endpoint. Set MINIMAX_API_KEY in the repo secrets.",
      "Every model in model_catalog is callable on this endpoint; the M2.x",
      "family is text+tool_use only (no image/video input)."
    ]
  },
  "model_catalog": {
    "MiniMax-M3": {
      "tier": "frontier",
      "maps_from_claude": "claude-3-opus-20240229",
      "context_window": 1000000,
      "max_output_tokens": 524288,
      "recommended_max_tokens": 131072,
      "supports": {
        "text": true,
        "vision": true,
        "tool_use": true,
        "thinking": true,
        "effort": false
      },
      "thinking": {
        "mode": "adaptive",
        "payload": { "type": "adaptive" }
      },
      "pricing": {
        "input_per_mtok": 0.30,
        "output_per_mtok": 1.20,
        "cache_read_per_mtok": 0.06,
        "note": "Permanent 50% off. Doubles to 0.60/2.40 above 512k input tokens."
      }
    },
    "MiniMax-M2.7": {
      "tier": "balanced",
      "maps_from_claude": "claude-3-5-sonnet-20240620",
      "context_window": 200000,
      "max_output_tokens": 204800,
      "recommended_max_tokens": 65536,
      "supports": {
        "text": true,
        "vision": false,
        "tool_use": true,
        "thinking": true,
        "effort": false
      },
      "thinking": {
        "mode": "budget",
        "payload": { "type": "enabled", "budget_tokens": 8192 }
      },
      "pricing": {
        "input_per_mtok": 0.30,
        "output_per_mtok": 1.20,
        "cache_read_per_mtok": 0.06,
        "cache_write_per_mtok": 0.375
      }
    },
    "MiniMax-M2.7-highspeed": {
      "tier": "latency",
      "maps_from_claude": "claude-3-5-sonnet-20240620",
      "context_window": 200000,
      "max_output_tokens": 204800,
      "recommended_max_tokens": 65536,
      "supports": {
        "text": true,
        "vision": false,
        "tool_use": true,
        "thinking": true,
        "effort": false
      },
      "thinking": {
        "mode": "budget",
        "payload": { "type": "enabled", "budget_tokens": 4096 }
      },
      "pricing": {
        "input_per_mtok": 0.60,
        "output_per_mtok": 2.40,
        "cache_read_per_mtok": 0.06,
        "cache_write_per_mtok": 0.375,
        "note": "Latency tier, NOT a cost tier — it is 2x the price of MiniMax-M2.7."
      }
    },
    "MiniMax-M3.1-Flash": {
      "tier": "fast",
      "maps_from_claude": "claude-3-haiku-20240307",
      "context_window": 1000000,
      "max_output_tokens": 524288,
      "recommended_max_tokens": 131072,
      "supports": {
        "text": true,
        "vision": true,
        "tool_use": true,
        "thinking": true,
        "effort": true
      },
      "thinking": {
        "mode": "always",
        "payload": { "type": "adaptive" },
        "note": "Always thinks. {\"type\":\"disabled\"} returns 400. Tune depth with output_config.effort."
      },
      "effort_values": ["low", "medium", "high", "xhigh", "max"],
      "pricing": {
        "input_per_mtok": 0.15,
        "output_per_mtok": 0.60,
        "cache_read_per_mtok": 0.015
      }
    },
    "MiniMax-M2.5": {
      "tier": "fallback",
      "maps_from_claude": "claude-3-5-sonnet-20240620",
      "context_window": 200000,
      "max_output_tokens": 204800,
      "recommended_max_tokens": 65536,
      "supports": {
        "text": true,
        "vision": false,
        "tool_use": true,
        "thinking": true,
        "effort": false
      },
      "thinking": {
        "mode": "budget",
        "payload": { "type": "enabled", "budget_tokens": 4096 }
      },
      "pricing": {
        "input_per_mtok": 0.30,
        "output_per_mtok": 1.20,
        "cache_read_per_mtok": 0.06
      }
    }
  },
  "defaults": {
    "max_tokens": 16384,
    "timeout_ms": 600000,
    "retries": 2,
    "retry_on": [429, 500, 502, 503, 504]
  },
  "agents": {
    "SWR-Ops": {
      "role": "Orchestrator",
      "system_prompt": "agents/swr-ops.md",
      "model_default": "MiniMax-M3",
      "models": {
        "planning": "MiniMax-M3",
        "coding": "MiniMax-M2.7",
        "triage": "MiniMax-M3.1-Flash"
      },
      "reasoning": {
        "planning": {
          "thinking": "adaptive",
          "note": "M3 decides its own depth. It does not accept output_config.effort."
        },
        "coding": {
          "thinking": "budget",
          "thinking_budget_tokens": 8192
        },
        "triage": {
          "effort": "low",
          "note": "M3.1-Flash only — this is the one model that accepts output_config.effort."
        }
      },
      "writes": ["agents/TASKS.md"]
    },
    "SWR-Twin": {
      "role": "Digital Twin",
      "system_prompt": "agents/swr-twin.md",
      "model_default": "MiniMax-M2.7",
      "models": {
        "creative": "MiniMax-M2.7",
        "planning": "MiniMax-M3"
      },
      "reasoning": {
        "creative": {
          "thinking": "budget",
          "thinking_budget_tokens": 8192
        }
      },
      "knowledge_roots": ["../digital_twin/"]
    },
    "SWR-Check": {
      "role": "Verifier",
      "system_prompt": "agents/swr-check.md",
      "model_default": "MiniMax-M3.1-Flash",
      "models": {
        "verification": "MiniMax-M3.1-Flash"
      },
      "reasoning": {
        "verification": {
          "effort": "low",
          "note": "A verdict should be cheap and repeatable, not a long think."
        }
      },
      "read_only": true
    }
  },
  "triggers": {
    "issue_opened": {
      "agent": "SWR-Ops",
      "model": "MiniMax-M3.1-Flash",
      "task": "triage",
      "action": "add_label_untriaged",
      "max_tokens": 4096
    },
    "issue_labeled_bug": {
      "agent": "SWR-Ops",
      "model": "MiniMax-M3",
      "task": "planning",
      "action": "decompose_to_tasks",
      "max_tokens": 32768
    },
    "pr_opened": {
      "agent": "SWR-Check",
      "model": "MiniMax-M3.1-Flash",
      "task": "verification",
      "action": "run_tests_and_diff_review",
      "max_tokens": 8192
    },
    "pr_merged": {
      "agent": "SWR-Twin",
      "model": "MiniMax-M2.7",
      "task": "creative",
      "action": "draft_release_notes",
      "max_tokens": 8192
    },
    "cron_nightly": {
      "agent": "SWR-Ops",
      "model": "MiniMax-M3",
      "task": "planning",
      "action": "run_archive_dry_run_and_doc_drift",
      "max_tokens": 32768
    }
  },
  "prompts": {
    "triage": "Triage this new issue. Read the audit context. If it is a bug, label it 'bug' and write a task in agents/TASKS.md. Report with the three headings: Blocked on me / Changed / Found.",
    "planning": "Read the drift report and the counts. If the README claims a number the code does not support, correct the README and log it in agents/TASKS.md as 'Found'. Never change product behaviour to satisfy a doc — fix the doc, or report the code as wrong.",
    "verification": "Review this diff. Look for blockers based on the audit report (e.g. silent video export bugs, CSS filter mismatches). Demand file:line evidence. Output PASS or FAIL as the first token, then the evidence.",
    "creative": "Draft the release notes for the merged PR. Use the twin's voice. Reference the merged commit and the visible change, not the branch name."
  },
  "tools": {
    "write_allowlist": [
      "agents/TASKS.md",
      "README.md",
      "CHANGELOG.md"
    ],
    "write_requires_flag": "--allow-writes",
    "note": "The bridge declares one tool, write_file. Without --allow-writes the tool is declared but every call is refused, so a CI run can never touch the tree by accident."
  }
}
