  "defaults": {
    "max_tokens": 16384,
    "timeout_ms": 600000,
    "retries": 2,
    "retry_on": [429, 500, 502, 503, 504]
  },
  "agents": {
    "SWR-Ops": {
      "role": "Orchestrator",
      "system_prompt": "agents/swr-ops.md",
      "model_default": "minimax/MiniMax-M3",
      "tasks": {
        "planning": {
          "primary": "minimax/MiniMax-M3",
          "fallbacks": ["xai/grok-4.7", "opencode/claude-sonnet-5"],
          "max_tokens": 32768
        },
        "coding": {
          "primary": "minimax/MiniMax-M2.7",
          "fallbacks": ["opencode/qwen3.7-plus", "xai/grok-4.6"],
          "max_tokens": 32768
        },
        "triage": {
          "primary": "minimax/MiniMax-M3.1-Flash",
          "fallbacks": ["opencode/deepseek-v4.1-flash", "xai/grok-4.7"],
          "effort": "low",
          "max_tokens": 4096
        }
      },
      "writes": ["agents/TASKS.md"]
    },
    "SWR-Twin": {
      "role": "Digital Twin",
      "system_prompt": "agents/swr-twin.md",
      "model_default": "minimax/MiniMax-M2.7",
      "tasks": {
        "creative": {
          "primary": "minimax/MiniMax-M2.7",
          "fallbacks": ["opencode/qwen3.7-plus", "antigravity/gemini-3.8-flash"],
          "max_tokens": 8192
        },
        "planning": {
          "primary": "minimax/MiniMax-M3",
          "fallbacks": ["xai/grok-4.7"],
          "max_tokens": 32768
        }
      },
      "knowledge_roots": ["../digital_twin/"]
    },
    "SWR-Check": {
      "role": "Verifier",
      "system_prompt": "agents/swr-check.md",
      "model_default": "minimax/MiniMax-M3.1-Flash",
      "tasks": {
        "verification": {
          "primary": "minimax/MiniMax-M3.1-Flash",
          "fallbacks": ["opencode/deepseek-v4.1-flash", "xai/grok-4.7"],
          "effort": "low",
          "max_tokens": 8192
        }
      },
      "read_only": true
    }
  },
  "triggers": {
    "issue_opened": {
      "agent": "SWR-Ops",
      "task": "triage",
      "action": "add_label_untriaged"
    },
    "issue_labeled_bug": {
      "agent": "SWR-Ops",
      "task": "planning",
      "action": "decompose_to_tasks"
    },
    "pr_opened": {
      "agent": "SWR-Check",
      "task": "verification",
      "action": "run_tests_and_diff_review"
    },
    "pr_merged": {
      "agent": "SWR-Twin",
      "task": "creative",
      "action": "draft_release_notes"
    },
    "cron_nightly": {
      "agent": "SWR-Ops",
      "task": "planning",
      "action": "run_archive_dry_run_and_doc_drift"
    }
  },
  "prompts": {
    "triage": "Triage this new issue. Read the audit context. If it is a bug, label it 'bug' and write a task in agents/TASKS.md. Report with the three headings: Blocked on me / Changed / Found.",
    "planning": "Read the drift report and the counts. If the README claims a number the code does not support, correct the README and log it in agents/TASKS.md as 'Found'. Never change product behaviour to satisfy a doc — fix the doc, or report the code as wrong.",
    "verification": "Review this diff. Look for blockers based on the audit report (e.g. silent video export bugs, CSS filter mismatches). Demand file:line evidence. Output PASS or FAIL as the first token, then the evidence.",
    "creative": "Draft the release notes for the merged PR. Use the twin's voice. Reference the merged commit and the visible change, not the branch name."
  },
  "tools": {
    "write_allowlist": [
      "agents/TASKS.md",
      "README.md",
      "CHANGELOG.md"
    ],
    "write_requires_flag": "--allow-writes",
    "note": "The bridge declares write_file for every agent that is not read-only. Without --allow-writes the tool is declared but every call is refused, so a CI run can never touch the tree by accident. CLI providers are exempt: their agent brings its own permissions, which the allowlist does not cover."
  }
}
