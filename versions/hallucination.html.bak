<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>HALLUCINATION · SWR engine v5</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root {
      --bg: #000000; --bg-2: #0a0008; --panel: #14000a; --panel-2: #1f0010;
      --ink: #ffffff; --muted: #ff44aa; --line: #330022;
      --r: #ff0066; --g: #00ff66; --b: #00ccff; --y: #ffff00; --p: #cc00ff;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #000; color: var(--ink);
      font-family: 'Courier New', ui-monospace, monospace; }
    body::before { content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 1000;
      background: repeating-linear-gradient(0deg, transparent 0px, transparent 2px, rgba(0,0,0,0.18) 3px, rgba(0,0,0,0.18) 4px); }
    #app { display: grid; grid-template-columns: 220px 1fr 220px; grid-template-rows: 48px 1fr 40px; height: 100vh; }
    header { grid-column: 1 / -1; display: flex; align-items: center; gap: 12px; padding: 0 14px;
      background: var(--bg-2); border-bottom: 2px solid var(--r); }
    .v { font-weight: 900; font-size: 18px; color: var(--ink); letter-spacing: -0.02em;
      text-shadow: 2px 0 var(--g), -2px 0 var(--b); animation: glitch 4s infinite; }
    @keyframes glitch { 0%, 90% { transform: none; } 92% { transform: translate(-2px, 1px); } 94% { transform: translate(2px, -1px); } 96% { transform: translate(-1px, 2px); } 100% { transform: none; } }
    .v small { color: var(--y); margin-left: 6px; font-weight: 400; letter-spacing: 0.16em; }
    .pill { font: 9px/1 ui-monospace; padding: 4px 8px; border: 1px solid var(--r); color: var(--r); letter-spacing: 0.14em; text-transform: uppercase; background: #1a000a; }
    .pill.ok { color: var(--g); border-color: var(--g); background: #001a08; }
    .pill.live { color: var(--y); border-color: var(--y); background: #1a1a00; animation: blink 0.3s infinite alternate; }
    @keyframes blink { from { opacity: 0.4; } to { opacity: 1; } }
    .tbtn { background: #000; color: var(--ink); border: 1px solid var(--ink); font: 10px/1 ui-monospace;
      letter-spacing: 0.12em; text-transform: uppercase; padding: 7px 12px; cursor: pointer; }
    .tbtn:hover { background: var(--r); color: #000; border-color: var(--r); }
    .tbtn.primary { background: var(--y); color: #000; border-color: var(--y); font-weight: 700; }
    .tbtn.primary:hover { background: var(--r); border-color: var(--r); }
    .spacer { flex: 1; }
    .meter { width: 160px; height: 18px; background: #000; border: 1px solid var(--ink); }
    aside.lib, aside.layers { background: var(--panel); overflow-y: auto; border-right: 1px solid var(--line); }
    aside.lib { border-right: 1px solid var(--line); }
    aside.layers { border-left: 1px solid var(--line); border-right: none; }
    .head { padding: 10px 12px; border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 8px;
      background: linear-gradient(90deg, var(--panel), var(--bg-2)); }
    .head h2 { margin: 0; font: 700 10px/1 ui-monospace; letter-spacing: 0.18em; text-transform: uppercase; color: var(--y); flex: 1; }
    .body { padding: 6px; }
    #lib { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
    .li { aspect-ratio: 1; background: #000; border: 1px solid var(--g); position: relative; cursor: pointer; }
    .li:hover { border-color: var(--y); transform: scale(1.04); }
    .li img, .li video { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(2) contrast(1.5); }
    .li .tag { position: absolute; top: 0; right: 0; font: 9px/1 ui-monospace; padding: 1px 3px; background: var(--y); color: #000; font-weight: 700; }
    .li .nm { position: absolute; bottom: 0; left: 0; right: 0; padding: 1px 3px; font: 9px/1 ui-monospace; color: #000; background: var(--r); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 700; }
    #layers { display: flex; flex-direction: column; gap: 4px; }
    .l { background: var(--panel-2); border: 1px solid var(--line); padding: 6px 8px; }
    .l:nth-child(odd) { border-left: 3px solid var(--r); }
    .l:nth-child(even) { border-left: 3px solid var(--g); }
    .l.sel { background: var(--y); color: #000; border-color: var(--y); }
    .l .lh { display: flex; align-items: center; gap: 6px; margin-bottom: 3px; }
    .l .lh .n { font: 700 9px/1 ui-monospace; width: 16px; }
    .l .lh .nm { flex: 1; font: 9px/1 ui-monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .l .lh .x { background: none; border: none; color: inherit; cursor: pointer; font-size: 12px; font-weight: 700; }
    .l .r { display: grid; grid-template-columns: 36px 1fr; gap: 4px; align-items: center; margin-top: 2px; }
    .l .r label { font: 8px/1 ui-monospace; text-transform: uppercase; letter-spacing: 0.08em; }
    .l .r select, .l .r input { background: #000; border: 1px solid currentColor; color: inherit;
      font: 9px ui-monospace; padding: 2px 3px; width: 100%; }
    .l .react { font: 8px/1.3 ui-monospace; color: var(--y); margin-top: 3px; letter-spacing: 0.04em; }
    section.stage { position: relative; background: #000; overflow: hidden; }
    canvas { display: block; width: 100%; height: 100%; }
    #noise { position: absolute; inset: 0; pointer-events: none; opacity: 0.3; mix-blend-mode: difference; }
    footer { grid-column: 1 / -1; display: flex; align-items: center; gap: 14px; padding: 0 14px;
      background: var(--bg-2); border-top: 2px solid var(--g); font: 9px/1 ui-monospace; color: var(--ink); letter-spacing: 0.08em; }
    .gc input { width: 70px; accent-color: var(--r); }
    .gc b { color: var(--y); }
    .led { width: 8px; height: 8px; background: #000; border: 1px solid var(--r); }
    .led.on { background: var(--r); box-shadow: 0 0 8px var(--r); }
    a.nav { color: var(--g); text-decoration: none; border: 1px solid var(--g); padding: 4px 8px;
      font: 9px/1 ui-monospace; letter-spacing: 0.12em; text-transform: uppercase; }
    a.nav:hover { background: var(--g); color: #000; }
    input[type=file] { display: none; }
  </style>
</head>
<body>
  <div id="app">
    <header>
      <div class="v">HALLUCINATION <small>v5</small></div>
      <span class="pill" id="status">idle</span>
      <button class="tbtn" id="load-song">Load song</button>
      <input type="file" id="song-input" accept="audio/*" />
      <button class="tbtn primary" id="play" disabled>▶</button>
      <span id="time" style="font-size:10px;color:var(--muted);">0:00 / 0:00</span>
      <canvas class="meter" id="meter" width="320" height="36"></canvas>
      <span class="spacer"></span>
      <span style="font:9px ui-monospace;display:flex;align-items:center;gap:4px;">BEAT <span class="led" id="beat-led"></span></span>
      <button class="tbtn" id="rec" disabled>● REC</button>
      <a class="nav" href="neon.html">restart</a>
    </header>
    <aside class="lib">
      <div class="head"><h2>Library</h2><button class="tbtn" id="add" style="padding:3px 8px;">+</button>
        <input type="file" id="asset-input" multiple accept="video/*,image/*,image/gif" /></div>
      <div class="body"><div id="lib"></div></div>
    </aside>
    <section class="stage">
      <canvas id="render"></canvas>
      <canvas id="noise"></canvas>
    </section>
    <aside class="layers">
      <div class="head"><h2>Layers</h2><button class="tbtn" id="remap" style="padding:3px 8px;">RE-MAP</button></div>
      <div class="body"><div id="layers"></div></div>
    </aside>
    <footer>
      <span class="gc">CHAOS <input type="range" id="sens" min="0.2" max="3" step="0.05" value="2" /> <b id="sens-v">2.00</b></span>
      <span class="gc">GATE <input type="range" id="gate" min="1.05" max="2.5" step="0.05" value="1.2" /> <b id="gate-v">1.20</b></span>
      <span class="gc">DECAY <input type="range" id="decay" min="0.5" max="0.99" step="0.01" value="0.6" /> <b id="decay-v">0.60</b></span>
      <span class="spacer" style="flex:1"></span>
      <span id="fps" style="color:var(--y);">— fps</span>
    </footer>
  </div>
  <script>
  (() => {
    const $ = id => document.getElementById(id);
    const stage = $('render');
    const ctx = stage.getContext('2d');
    const noise = $('noise');
    const nctx = noise.getContext('2d');
    const meter = $('meter').getContext('2d');
    let W, H, NW, NH;
    const lerp = (a,b,t) => a+(b-a)*t;
    const clamp = (v,lo,hi) => Math.max(lo,Math.min(hi,v));
    const fmt = s => { if (!isFinite(s)||s<0) s=0; const m=Math.floor(s/60); return m+':'+Math.floor(s%60).toString().padStart(2,'0'); };
    function setStatus(t,cls) { const p=$('status'); p.textContent=t; p.className='pill'+(cls?' '+cls:''); }
    const A = { ctx:null, an:null, src:null, el:null, gain:null, fft:null, time:null,
      feat:{bass:0,mid:0,treble:0,air:0,sub:0,rms:0,centroid:0,beat:0,onset:0,beatPulse:false,onsetPulse:false,bpm:0},
      hist:{prev:null,bassAvg:0,fluxAvg:0}, beats:[], playing:false,
      unlock() { if (this.ctx) return; this.ctx = new (window.AudioContext||window.webkitAudioContext)();
        this.an = this.ctx.createAnalyser(); this.an.fftSize=2048; this.an.smoothingTimeConstant=0.4;
        this.fft = new Uint8Array(this.an.frequencyBinCount); this.time = new Uint8Array(this.an.fftSize);
        this.gain = this.ctx.createGain(); this.gain.gain.value=1;
        this.an.connect(this.gain); this.gain.connect(this.ctx.destination);
        setStatus('ready','ok'); },
      load(f) { this.unlock(); if (this.src) try{this.src.disconnect();}catch{};
        if (this.el) { this.el.pause(); this.el.src=''; }
        this.el = new Audio(); this.el.crossOrigin='anonymous';
        this.el.src = URL.createObjectURL(f); this.el.preload='auto';
        this.el.addEventListener('ended', ()=>{A.playing=false;$('play').textContent='▶';});
        this.el.addEventListener('timeupdate', ()=>{const t=this.el.currentTime,d=this.el.duration||0;$('time').textContent=fmt(t)+' / '+fmt(d);});
        this.src = this.ctx.createMediaElementSource(this.el); this.src.connect(this.an);
        this.hist = {prev:null,bassAvg:0,fluxAvg:0}; this.beats=[]; this.feat.bpm=0;
        $('play').disabled=false; $('rec').disabled=false; },
      play() { this.unlock(); if (this.ctx.state==='suspended') this.ctx.resume();
        this.el.play(); this.playing=true; $('play').textContent='❚❚'; },
      pause() { if (this.el) this.el.pause(); this.playing=false; $('play').textContent='▶'; },
      sample() { if (!this.an) return;
        this.an.getByteFrequencyData(this.fft);
        this.an.getByteTimeDomainData(this.time);
        const N=this.fft.length, sr=this.ctx.sampleRate, hz=sr/this.an.fftSize;
        const mean=(lo,hi)=>{let s=0,c=0;for(let i=lo;i<=hi&&i<N;i++){s+=this.fft[i];c++;}return s/c/255;};
        this.feat.bass=mean(Math.floor(60/hz),Math.floor(250/hz));
        this.feat.mid=mean(Math.floor(250/hz),Math.floor(2000/hz));
        this.feat.treble=mean(Math.floor(2000/hz),Math.floor(6000/hz));
        this.feat.air=mean(Math.floor(6000/hz),N-1);
        let rms=0; for (let i=0;i<this.time.length;i++){const v=(this.time[i]-128)/128;rms+=v*v;}
        this.feat.rms = Math.sqrt(rms/this.time.length);
        let num=0,den=0; for (let i=1;i<N;i++){num+=i*this.fft[i];den+=this.fft[i];}
        this.feat.centroid = den>0?num/den/N:0;
        let flux=0; if (this.hist.prev) for (let i=1;i<N;i++){const d=this.fft[i]-this.hist.prev[i]; if (d>0) flux+=d;}
        flux /= 255*N;
        this.hist.fluxAvg = lerp(this.hist.fluxAvg, flux, 0.1);
        this.hist.bassAvg = lerp(this.hist.bassAvg, this.feat.bass, 0.08);
        const gate = parseFloat($('gate').value);
        const onsetHit = flux > this.hist.fluxAvg*gate && flux > 0.025;
        const beatHit = this.feat.bass > this.hist.bassAvg*gate && this.feat.bass > 0.16;
        const now = this.ctx.currentTime;
        if (beatHit) { this.beats.push(now); while (this.beats.length&&this.beats[0]<now-8) this.beats.shift();
          if (this.beats.length>=4) { let t=0; for (let i=1;i<this.beats.length;i++) t+=this.beats[i]-this.beats[i-1];
            const a=t/(this.beats.length-1); if (a>0) this.feat.bpm=Math.round(60/a); } }
        const dec = parseFloat($('decay').value);
        this.feat.beat = beatHit?1:this.feat.beat*dec;
        this.feat.onset = onsetHit?1:this.feat.onset*dec;
        this.feat.beatPulse=beatHit; this.feat.onsetPulse=onsetHit;
        this.hist.prev = Uint8Array.from(this.fft);
        $('beat-led').classList.toggle('on', beatHit);
        $('onset-led') && $('onset-led').classList.toggle('on', onsetHit);
      }
    };
    const Lib = { items: [], nextId: 1,
      async addFiles(files) { const seen=new Set(this.items.map(i=>i.name+':'+i.blob?.size));
        for (const f of files) { if (!f.type) continue; const k=f.name+':'+f.size; if (seen.has(k)) continue; seen.add(k);
          const it = { id: this.nextId++, name: f.name, type: f.type.startsWith('video/')?'video':'image',
            blob: f, url: URL.createObjectURL(f), motion:0, luma:0.5, hue:0, w:0, h:0, added: Date.now(), thumb: null };
          this.items.push(it); this._classify(it); }
        this.render(); },
      _classify(it) {
        const c=document.createElement('canvas'); c.width=32;c.height=32; const cx=c.getContext('2d');
        const src = it.type==='video' ? Object.assign(document.createElement('video'),{src:it.url,muted:true,playsInline:true,preload:'metadata'}) : Object.assign(new Image(),{src:it.url});
        src.addEventListener(src.tagName==='VIDEO'?'loadeddata':'load', ()=>{
          cx.drawImage(src, 0,0,32,32);
          const d=cx.getImageData(0,0,32,32).data;
          let luma=0; for (let i=0;i<d.length;i+=4) luma += 0.299*d[i]+0.587*d[i+1]+0.114*d[i+2];
          it.luma = (luma/(d.length/4))/255;
          let sx=0,sy=0; for (let i=0;i<d.length;i+=4){
            const mx=Math.max(d[i],d[i+1],d[i+2]),mn=Math.min(d[i],d[i+1],d[i+2]);
            if (mx===mn) continue; const df=mx-mn; let h=0;
            if (mx===d[i]) h=((d[i+1]-d[i+2])/df)%6;
            else if (mx===d[i+1]) h=(d[i+2]-d[i])/df+2;
            else h=(d[i]-d[i+1])/df+4; h/=6;
            sx+=Math.cos(h*Math.PI*2); sy+=Math.sin(h*Math.PI*2);
          }
          it.hue = (Math.atan2(sy/(d.length/4),sx/(d.length/4))/(Math.PI*2)+1)%1;
          it.w=src.videoWidth||src.naturalWidth; it.h=src.videoHeight||src.naturalHeight;
          const tcv=document.createElement('canvas'); tcv.width=120;tcv.height=120;
          tcv.getContext('2d').drawImage(src,0,0,120,120);
          it.thumb = tcv.toDataURL('image/jpeg',0.7);
          this.render();
        }, { once: true });
      },
      render() { const el=$('lib');
        if (!this.items.length) { el.innerHTML='<div style="grid-column:1/-1;color:var(--y);font:10px ui-monospace;padding:16px;text-align:center;background:#1a1a00;">DROP FILES</div>'; return; }
        el.innerHTML='';
        for (const it of this.items) {
          const d=document.createElement('div'); d.className='li';
          d.innerHTML=`<span class="tag">${it.type==='video'?'V':'I'}</span><span class="nm">${it.name}</span>`;
          if (it.thumb) { const i=new Image(); i.src=it.thumb; d.appendChild(i); }
          else if (it.type==='video') { const v=document.createElement('video'); v.src=it.url;v.muted=true;v.playsInline=true;d.appendChild(v); }
          else { const i=new Image(); i.src=it.url; d.appendChild(i); }
          d.addEventListener('click', () => Layers.add(it));
          el.appendChild(d);
        }
      }
    };
    const Layers = { list: [], sel: null,
      add(it) { const i=this.list.length;
        // HALLUCINATION: every reactor maxed
        const presets = [
          [ { feature:'bass', target:'scale', scale: 1.2, ease:'sharp' }, { feature:'beat', target:'opacity', scale: 1.0, ease:'sharp' }, { feature:'centroid', target:'hue', scale: 360, ease:'sharp' } ],
          [ { feature:'mid', target:'hue', scale: 720, ease:'sharp' }, { feature:'rms', target:'scale', scale: 0.8, ease:'sharp' }, { feature:'onset', target:'x', scale: 200, ease:'sharp' } ],
          [ { feature:'treble', target:'rot', scale: 180, ease:'sharp' }, { feature:'air', target:'y', scale: 200, ease:'sharp' }, { feature:'onset', target:'scale', scale: 0.5, ease:'sharp' } ],
          [ { feature:'rms', target:'scale', scale: 1.0, ease:'sharp' }, { feature:'onset', target:'brightness', scale: 1.0, ease:'sharp' }, { feature:'beat', target:'hue', scale: 180, ease:'sharp' } ],
          [ { feature:'centroid', target:'hue', scale: 720, ease:'sharp' }, { feature:'treble', target:'scale', scale: 0.8, ease:'sharp' }, { feature:'bass', target:'x', scale: 150, ease:'sharp' } ],
          [ { feature:'bass', target:'scale', scale: 1.5, ease:'sharp' }, { feature:'beat', target:'opacity', scale: 1.2, ease:'sharp' }, { feature:'mid', target:'rot', scale: 90, ease:'sharp' } ],
        ];
        const l = { id:'L'+(i+1), asset: it, blend:['lighter','difference','screen','multiply','lighter','difference'][i%6],
          opacity: 0.85, baseScale: [1.0, 1.3, 0.8, 1.5, 0.6, 1.8][i%6], hue: 0, brightness: 1.4, contrast: 1.6, reactors: presets[i%presets.length] };
        this.list.push(l); this.render(); this.sel=l; },
      rm(id) { this.list=this.list.filter(l=>l.id!==id); this.render(); },
      render() {
        const el=$('layers'); el.innerHTML='';
        for (let i=0;i<this.list.length;i++) {
          const l=this.list[i]; const d=document.createElement('div'); d.className='l'+(this.sel===l?' sel':'');
          const react = l.reactors.map(r=>`${r.feature}→${r.target}×${r.scale.toFixed(2)}`).join(' · ');
          d.innerHTML=`<div class="lh"><span class="n">${(i+1).toString().padStart(2,'0')}</span><span class="nm">${l.asset?l.asset.name.slice(0,16):'(empty)'}</span><button class="x">×</button></div><div class="react">${react}</div><div class="r"><label>blend</label><select><option>source-over</option><option>screen</option><option>lighter</option><option>multiply</option><option>overlay</option><option>difference</option></select></div><div class="r"><label>opacity</label><input type="range" min="0" max="1.5" step="0.01" /></div><div class="r"><label>scale</label><input type="range" min="0.1" max="3" step="0.01" /></div><div class="r"><label>hue</label><input type="range" min="-180" max="180" step="1" /></div>`;
          d.querySelector('select').value=l.blend;
          const ins=d.querySelectorAll('input[type=range]');
          ins[0].value=l.opacity; ins[1].value=l.baseScale; ins[2].value=l.hue;
          d.querySelector('select').addEventListener('change', e=>l.blend=e.target.value);
          ins[0].addEventListener('input', e=>l.opacity=+e.target.value);
          ins[1].addEventListener('input', e=>l.baseScale=+e.target.value);
          ins[2].addEventListener('input', e=>l.hue=+e.target.value);
          d.querySelector('.x').addEventListener('click', e=>{e.stopPropagation();this.rm(l.id);});
          el.appendChild(d);
        }
      },
      remap() {
        if (!Lib.items.length) return;
        const f=A.feat; const sens=parseFloat($('sens').value);
        const roles = [
          { want:'motion', weight: 0.6 + f.bass * sens * 2 },
          { want:'mid',    weight: 0.4 + f.mid * sens * 2 },
          { want:'luma',   weight: 0.3 + f.treble * sens * 2 },
          { want:'hue',    weight: 0.2 + f.air * sens * 2 },
          { want:'motion', weight: 0.5 + f.rms * sens * 3 },
          { want:'motion', weight: 0.7 + f.onset * sens * 4 },
        ];
        const scored = Lib.items.map(it => {
          const sc = {};
          sc.motion = it.motion*0.7 + (1-Math.abs(it.luma-0.5)*2)*0.3;
          sc.mid = it.luma*0.5 + (1-it.motion)*0.5;
          sc.luma = (1-it.motion)*0.4 + it.luma*0.6;
          sc.hue = it.hue*0.5 + (1-it.motion)*0.5;
          return { it, sc };
        });
        const used = new Set();
        const assignments = roles.map(r => {
          let best=null,bestS=-1;
          for (const s of scored) { if (used.has(s.it.id)) continue;
            const v = s.sc[r.want] * r.weight; if (v>bestS) { bestS=v; best=s.it; } }
          if (best) used.add(best.id);
          return best;
        });
        this.list = [];
        const presets = [
          [ { feature:'bass', target:'scale', scale: 1.2, ease:'sharp' }, { feature:'beat', target:'opacity', scale: 1.0, ease:'sharp' }, { feature:'centroid', target:'hue', scale: 360, ease:'sharp' } ],
          [ { feature:'mid', target:'hue', scale: 720, ease:'sharp' }, { feature:'rms', target:'scale', scale: 0.8, ease:'sharp' }, { feature:'onset', target:'x', scale: 200, ease:'sharp' } ],
          [ { feature:'treble', target:'rot', scale: 180, ease:'sharp' }, { feature:'air', target:'y', scale: 200, ease:'sharp' }, { feature:'onset', target:'scale', scale: 0.5, ease:'sharp' } ],
          [ { feature:'rms', target:'scale', scale: 1.0, ease:'sharp' }, { feature:'onset', target:'brightness', scale: 1.0, ease:'sharp' }, { feature:'beat', target:'hue', scale: 180, ease:'sharp' } ],
          [ { feature:'centroid', target:'hue', scale: 720, ease:'sharp' }, { feature:'treble', target:'scale', scale: 0.8, ease:'sharp' }, { feature:'bass', target:'x', scale: 150, ease:'sharp' } ],
          [ { feature:'bass', target:'scale', scale: 1.5, ease:'sharp' }, { feature:'beat', target:'opacity', scale: 1.2, ease:'sharp' }, { feature:'mid', target:'rot', scale: 90, ease:'sharp' } ],
        ];
        for (let i=0;i<assignments.length;i++) {
          if (!assignments[i]) continue;
          this.list.push({
            id:'L'+(i+1), asset: assignments[i], blend:['lighter','difference','screen','multiply','lighter','difference'][i%6],
            opacity:0.85, baseScale:[1.0,1.3,0.8,1.5,0.6,1.8][i%6], hue:0, brightness:1.4, contrast:1.6,
            reactors: presets[i%presets.length]
          });
        }
        this.render();
      }
    };
    let fps=0, lastT=performance.now();
    function fit() { const vw=stage.clientWidth,vh=stage.clientHeight;
      stage.width=Math.max(640,Math.round(vw)); stage.height=Math.max(360,Math.round(vh));
      noise.width=stage.width; noise.height=stage.height;
      W=stage.width; H=stage.height; NW=W; NH=H; }
    fit();
    function ease(name,t) {
      if (name==='sharp') return Math.pow(t,0.3);
      if (name==='soft') return t*t*(3-2*t);
      return t;
    }
    function applyR(l) {
      const sens=parseFloat($('sens').value);
      const out = { scale:l.baseScale, x:0, y:0, rot:l.hue*0.1, opacity:l.opacity, hue:l.hue, brightness:l.brightness, contrast:l.contrast };
      for (const r of l.reactors) {
        let v = A.feat[r.feature] ?? 0;
        v = ease(r.ease, clamp(v,0,1)) * r.scale * sens;
        if (r.target==='scale') out.scale += v;
        else if (r.target==='x') out.x += v * 150;
        else if (r.target==='y') out.y += v * 150;
        else if (r.target==='rot') out.rot += v * 45;
        else if (r.target==='opacity') out.opacity = clamp(out.opacity + v*0.7, 0, 1.5);
        else if (r.target==='hue') out.hue += v * 80;
        else if (r.target==='brightness') out.brightness = clamp(out.brightness + v*0.7, 0.1, 3);
        else if (r.target==='contrast') out.contrast = clamp(out.contrast + v*0.7, 0.1, 3);
      }
      return out;
    }
    function drawLayer(l, idx) {
      const a=l.asset; if (!a) return;
      let src;
      if (a.type==='video') {
        if (!a._el) { a._el=document.createElement('video'); a._el.src=a.url; a._el.muted=true; a._el.loop=true; a._el.playsInline=true; a._el.preload='auto'; }
        src=a._el;
        if (A.playing && src.paused) src.play().catch(()=>{});
        if (!A.playing && !src.paused) src.pause();
      } else {
        if (!a._el) { a._el=new Image(); a._el.src=a.url; }
        src=a._el;
      }
      if (a.type==='video' && src.readyState<2) return;
      const r=applyR(l);
      // RGB shift: offset color channels
      const ar = (a.w||src.naturalWidth||src.videoWidth||1) / (a.h||src.naturalHeight||src.videoHeight||1);
      const car = W/H;
      let dw,dh;
      if (ar>car) { dh=H*r.scale; dw=dh*ar; } else { dw=W*r.scale; dh=dw/ar; }
      const dx=(W-dw)/2 + r.x; const dy=(H-dh)/2 + r.y;
      const shift = A.feat.bass * 30 + A.feat.onset * 40;
      // R channel
      ctx.save();
      ctx.globalCompositeOperation = l.blend || 'lighter';
      ctx.globalAlpha = clamp(r.opacity, 0, 1);
      ctx.filter = `hue-rotate(${r.hue}deg) saturate(${1.5 + r.contrast}) brightness(${r.brightness}) contrast(${r.contrast})`;
      ctx.drawImage(src, dx + shift, dy, dw, dh);
      ctx.restore();
      // G channel offset
      ctx.save();
      ctx.globalCompositeOperation = l.blend || 'lighter';
      ctx.globalAlpha = clamp(r.opacity * 0.7, 0, 1);
      ctx.filter = `hue-rotate(${r.hue + 60}deg) saturate(${1.5 + r.contrast}) brightness(${r.brightness}) contrast(${r.contrast})`;
      ctx.drawImage(src, dx - shift * 0.5, dy - shift * 0.3, dw, dh);
      ctx.restore();
      // B channel
      ctx.save();
      ctx.globalCompositeOperation = l.blend || 'lighter';
      ctx.globalAlpha = clamp(r.opacity * 0.7, 0, 1);
      ctx.filter = `hue-rotate(${r.hue + 200}deg) saturate(${1.5 + r.contrast}) brightness(${r.brightness}) contrast(${r.contrast})`;
      ctx.drawImage(src, dx - shift, dy + shift * 0.4, dw, dh);
      ctx.restore();
    }
    function drawNoise() {
      nctx.fillStyle = '#000';
      nctx.fillRect(0, 0, NW, NH);
      if (A.feat.onset < 0.05 && A.feat.beat < 0.3) return;
      const id = nctx.createImageData(NW, NH);
      const d = id.data;
      const intensity = (A.feat.onset + A.feat.beat) * 0.3;
      for (let i=0; i<d.length; i+=4) {
        const v = Math.random() < intensity * 0.2 ? 255 : 0;
        d[i] = v; d[i+1] = v; d[i+2] = v; d[i+3] = v ? 80 : 0;
      }
      // sample down
      const step = 4;
      const small = nctx.createImageData(NW/step, NH/step);
      const sd = small.data;
      for (let y=0; y<NH/step; y++) for (let x=0; x<NW/step; x++) {
        const v = Math.random() < intensity * 0.4 ? 255 : 0;
        const o = (y*NW/step + x) * 4;
        sd[o] = v; sd[o+1] = v; sd[o+2] = v; sd[o+3] = v ? 120 : 0;
      }
      nctx.putImageData(small, 0, 0);
    }
    function drawFx() {
      if (A.feat.beat > 0.4) {
        ctx.save(); ctx.globalCompositeOperation = 'lighter';
        ctx.fillStyle = `rgba(255,255,0,${A.feat.beat * 0.4})`;
        ctx.fillRect(0,0,W,H); ctx.restore();
      }
    }
    function drawMeter() {
      const m=meter, w=m.canvas.width, h=m.canvas.height;
      m.fillStyle='#000'; m.fillRect(0,0,w,h);
      const sens=parseFloat($('sens').value);
      const vals=[A.feat.bass*sens, A.feat.mid*sens, A.feat.treble*sens, A.feat.air*sens, A.feat.onset*sens*2];
      const bw=w/vals.length;
      for (let i=0;i<vals.length;i++) {
        const v=clamp(vals[i],0,1);
        const bh=v*h, x=i*bw+2, y=h-bh;
        const colors = ['#ff0066','#00ff66','#00ccff','#ffff00','#cc00ff'];
        m.fillStyle = colors[i];
        m.fillRect(x, y, bw-4, bh);
      }
    }
    function loop(t) {
      const dt=(t-lastT)/1000; lastT=t; fps=lerp(fps,1/Math.max(dt,0.0001),0.05);
      $('fps').textContent = Math.round(fps)+' fps';
      if (A.playing) A.sample();
      ctx.fillStyle = '#000'; ctx.fillRect(0,0,W,H);
      const sorted = Layers.list.slice().sort((a,b) => (a.z||0) - (b.z||0));
      for (let i=0; i<sorted.length; i++) drawLayer(sorted[i], i);
      drawFx();
      drawNoise();
      drawMeter();
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);
    $('load-song').addEventListener('click', () => $('song-input').click());
    $('song-input').addEventListener('change', e => { if (e.target.files[0]) A.load(e.target.files[0]); });
    $('play').addEventListener('click', () => { if (!A.el) return; A.playing?A.pause():A.play(); });
    $('add').addEventListener('click', () => $('asset-input').click());
    $('asset-input').addEventListener('change', e => { Lib.addFiles(e.target.files); e.target.value=''; });
    $('remap').addEventListener('click', () => { Layers.remap(); setStatus('CHAOS ' + Layers.list.length, 'live'); });
    for (const id of ['sens','gate','decay']) { const inp=$(id); const out=$(id+'-v');
      inp.addEventListener('input', () => out.textContent = parseFloat(inp.value).toFixed(2)); }
    window.addEventListener('dragover', e => e.preventDefault());
    window.addEventListener('drop', async e => { e.preventDefault(); if (e.dataTransfer.files?.length) await Lib.addFiles(e.dataTransfer.files); });
    window.addEventListener('resize', fit);
    (async () => {
      try {
        const r = await fetch('../library/manifest.json', { cache: 'no-cache' });
        if (r.ok) { const m = await r.json();
          const blobs = await Promise.all((m.files||[]).map(async f => { const fr=await fetch('../library/'+f); return await fr.blob(); }));
          await Lib.addFiles(blobs.map((b,i) => new File([b], m.files[i], { type: b.type })));
          setTimeout(() => Layers.remap(), 600);
        }
      } catch (e) {}
      setStatus('READY', 'ok');
    })();
    window.SWR = { Audio: A, Library: Lib, Layers, get stage() { return stage; }, get ctx() { return ctx; } };
  })();
  </script>
</body>
</html>
