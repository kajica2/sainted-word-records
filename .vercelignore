# Curated library/ ships via copyStatic (only manifest-listed files, ~33MB).
# Block public/library/ (the un-trimmed mirror, 75MB) from being re-shipped
# by Vite's copyPublicDir. The 4 un-curated style-* dirs in public/ are
# still stripped by the closeBundle hook in vite.config.js.
public/library/
# Audio loops and the coltrane track stay out of the deploy. The engine
# loads audio on demand via the file picker, not at boot.
library/audio/